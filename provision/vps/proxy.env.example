# Copy to /etc/kajianq/proxy.env on the VPS: `install -o root -g root -m 0600`.
# Read by provision/vps/apply.sh, which substitutes these into the shipped
# nginx server block. Never commit the filled-in file — this repository holds
# placeholders only, deliberately (no real hostname, TLS path, or origin IP in
# the diff).
#
# KAJIANQ_DOMAIN        the public hostname the certificate is issued for
# KAJIANQ_TLS_CERT      path to the fullchain PEM (e.g. Let's Encrypt)
# KAJIANQ_TLS_KEY       path to the private key PEM
# KAJIANQ_API_UPSTREAM  scheme://host:port of the API process (loopback)

KAJIANQ_DOMAIN=chat.example.org
KAJIANQ_TLS_CERT=/etc/letsencrypt/live/chat.example.org/fullchain.pem
KAJIANQ_TLS_KEY=/etc/letsencrypt/live/chat.example.org/privkey.pem
KAJIANQ_API_UPSTREAM=http://127.0.0.1:8787
