# Copy to /etc/kajianq/deploy.env on the deploying machine:
#   install -o root -g root -m 0600 provision/vps/deploy/deploy.env.example /etc/kajianq/deploy.env
# The deploy script refuses to source a file with group/other permission bits.
#
# Never commit the filled-in file: the repository is public, and a real hostname
# or origin address must not enter its history (docs/VPS-BASELINE-SETUP.md).
# The placeholders below are deliberately fake.

# The server. An ssh-config alias works too, and is the cleaner choice when the
# real address should not be typed here at all.
KAJIANQ_DEPLOY_HOST=<vps-host>

# The unprivileged login user created in the baseline runbook (never root: the
# deploy needs sudo for `systemctl restart`, and nothing else).
KAJIANQ_DEPLOY_USER=<deploy-user>

# The deployed tree on the box. Must match WorkingDirectory/ReadWritePaths in
# provision/vps/systemd/kajianq-api.service (/srv/kajianq).
KAJIANQ_DEPLOY_ROOT=/srv/kajianq

# The public base URL the smoke test hits — through DNS, the proxy, and TLS, so
# the smoke exercises the real ingress rather than the loopback port.
KAJIANQ_PUBLIC_URL=https://chat.example.org
