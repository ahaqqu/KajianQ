# Copy to /etc/kajianq/deploy.env on the deploying machine:
#   install -o root -g root -m 0600 provision/vps/deploy/deploy.env.example /etc/kajianq/deploy.env
# The deploy script refuses to source a file with group/other permission bits.
#
# Never commit the filled-in file: the repository is public, and a real hostname
# or origin address must not enter its history (docs/VPS-OPERATIONS.md).
# The placeholders below are deliberately fake.

# The server. An ssh-config alias works too, and is the cleaner choice when the
# real address should not be typed here at all.
KAJIANQ_DEPLOY_HOST=<vps-host>

# The deploy identity: `kajianq-deploy` (ADR-0044 decision 6).
# A dedicated unprivileged account provisioned by the host configuration in
# ahaqqu/vps. Its authorization is the shared `vps-deploy kajianq` helper
# (deploy, `--rollback` and the four bounded service verbs), the cron proof
# (`systemctl start kajianq-cron.service`) and the two read-only doctor
# diagnostics (`nginx -t`, `certbot certificates`). The installed grant still
# carries the legacy raw restart until the host-configuration cleanup lands;
# this deploy never invokes it. Never the owner's admin login: the deploy must
# not ride a human account's broader rights.
KAJIANQ_DEPLOY_USER=kajianq-deploy

# Optional operator label for the deployed tree. The helper reads the
# authoritative target from its root-only contract in ahaqqu/vps (the same
# repository's `kajianq` manifest carries the API unit); this value is logged
# for comparison and never gated.
KAJIANQ_DEPLOY_ROOT=/srv/kajianq

# The public base URL the smoke test hits — through DNS, the proxy, and TLS, so
# the smoke exercises the real ingress rather than the loopback port.
KAJIANQ_PUBLIC_URL=https://chat.example.org

# The database the deploy's migration preflight reads before it builds or
# uploads anything. It must name a LOOPBACK host and the tunnel port: deploy.sh
# opens an ssh tunnel from that local port to the box's own loopback Postgres
# (5432), runs `bun run db:status:all`, and closes the tunnel again. The URL
# carries the database password, so this file stays mode 0600 and the value
# never reaches a command line. On the workflow path this is
# secrets.STAGING_DATABASE_URL (the same value the Staging smoke uses), not this
# file.
# The preflight refuses the deploy when the value is missing or the status
# command cannot run; pass --skip-migration-check explicitly to deploy anyway.
DATABASE_URL=postgres://kajianq:<db-password>@localhost:15433/kajianq

# Post-deploy shared-box gate (§5): the read-only doctor sweep is the one copy
# on the box at /srv/vps-ops/doctor.sh (canonical: the private ahaqqu/homepage
# repo), run over ssh — no URL or credential to configure here.
