# provision/vps/systemd/kajianq-cron.service — the anonymous-session
# reclamation cron (ADR-0017, ADR-0044, issue #181).
#
# ADR-0017's nightly reclamation (`cleanupExpiredSessions`) was a Cloudflare
# Worker cron trigger; on the VPS it is this systemd timer invoking the
# dedicated entry `apps/api/src/cleanup.ts`. One job, one mechanism: the
# schedule is visible in `systemctl list-timers`, and the reclamation runs even
# when the serving process is unhealthy (different failure modes).
#
# The unit is oneshot: systemd runs it to completion and records the result.
# Credentials come from the same root-owned env file as the API unit — never
# argv, never this file.

[Unit]
Description=KajianQ anonymous-session reclamation (ADR-0017)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=kajianq
Group=kajianq
WorkingDirectory=/srv/kajianq/api
EnvironmentFile=/etc/kajianq/api.env
ExecStart=/usr/bin/bun run /srv/kajianq/api/cleanup.js

# Hardening mirrors kajianq-api.service: the job needs the network and its own
# tree, nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/srv/kajianq/api
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

StandardOutput=journal
StandardError=journal
