# Copy to /etc/kajianq/backup.env on the VPS: `install -o root -g root -m 0600`.
# Read by provision/vps/backup/kajianq-backup.mjs and kajianq-restore.mjs.
# Never commit the filled-in file.
#
# The backup target is the owner's encrypted storage endpoint. It must not be a
# free tier (ADR-0043's register rule): the repository holds a full-database
# dump, which carries chat content and feedback.
#
# RESTIC_PASSWORD_FILE points at the repository key. It must be chmod 600 and
# owned by root, and it must live OUTSIDE this repository (ADR-0043 decision 4:
# "a key held outside the repo"). Losing it makes every backup unrecoverable;
# leaking it makes every backup plaintext. Store a copy in the owner's password
# manager.
#
# PGDATABASE_URL is the SELF-HOSTED Postgres on the VPS. The backup script
# decomposes it into libpq PG* env vars, so the password never appears in the
# process table.

RESTIC_REPOSITORY=sftp:backup@backup.example.org:/srv/restic/kajianq
RESTIC_PASSWORD_FILE=/etc/kajianq/restic.pass
PGDATABASE_URL=postgres://kajianq:CHANGE_ME@127.0.0.1:5432/kajianq
