{
  "upstream": "https://github.com/ahaqqu/agentic-project-template.git",
  "overwrite": [
    ".github/workflows/e2e.yml",
    ".github/workflows/vuln-scan.yml",
    ".github/workflows/dependabot-auto-merge.yml",
    ".github/workflows/template-sync.yml",
    "scripts/template-sync/",
    "scripts/check-agentic-limits.mjs",
    "scripts/check-template-truth.mjs",
    "scripts/openapi-check.mjs",
    "flake.nix",
    "tsconfig.base.json",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "merge": [
    "apps/",
    "packages/",
    "package.json",
    "README.md",
    "CONTEXT.md",
    "bun.lock",
    ".github/workflows/ci.yml"
  ],
  "_comment_ci": "ci.yml moved from overwrite to merge: the fork wires its own infrastructure secrets (NEON_DATABASE_URL, and the existing Cloudflare/D1 secrets in staging.yml) into CI test steps, which makes workflows fork-owned in practice. Decided in #4's PR review."
}