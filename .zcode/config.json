{
  "hooks": {
    "enabled": true,
    "events": {
      "PostToolUse": [
        {
          "matcher": "Agent",
          "hooks": [
            {
              "type": "process",
              "command": "bun",
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/agent-usage-metadata/hook.mjs"
              ],
              "enabled": true,
              "timeoutMs": 30000,
              "statusMessage": "Recording subagent token usage (dispatch completed)"
            }
          ]
        },
        {
          "matcher": "TaskOutput",
          "hooks": [
            {
              "type": "process",
              "command": "bun",
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/agent-usage-metadata/hook.mjs"
              ],
              "enabled": true,
              "timeoutMs": 30000,
              "statusMessage": "Recording subagent token usage (result collected)"
            }
          ]
        }
      ]
    }
  }
}
