CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon Postgres (issue #4). Pooled connection string: hostname contains
# "-pooler" and the URL must include ?sslmode=require. Used by the migration
# CLI and the RagStore contract tests; also mirrored as a GitHub Secret for CI.
NEON_DATABASE_URL=
# Optional, v1: only needed for CI-managed Neon branching, not local runs.
# NEON_API_KEY=

# R2 S3-compatible access for the ingestion CLI (buckets kajianq-raw and
# kajianq-raw-staging already exist). Runtime in the Worker uses the bound
# bucket (apps/api env.BUCKET); these keys are for off-Workers scripts only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_STAGING=kajianq-raw-staging
R2_BUCKET_PROD=kajianq-raw

# Optional error tracking (free tier). Both DSNs unset = Sentry fully disabled.
# Worker runtime errors: `bunx wrangler secret put SENTRY_DSN` in prod/staging.
# SENTRY_DSN=
# Web build-time errors-only reporting (Session Replay is opt-in, see apps/web/src/lib/sentry.ts):
# VITE_SENTRY_DSN=

# Ingestion CLI source/report dirs (issues #6, #7). Setting a SOURCE_DIR
# makes the CLI reuse cached source files for offline re-runs; a REPORT_DIR
# writes the run's IngestionReport JSON alongside the eval_runs ledger row.
# QURAN_SOURCE_DIR=
# HADITH_SOURCE_DIR=
# HADITH_REPORT_DIR=
# HADITH_EDITIONS_BASE_URL=
