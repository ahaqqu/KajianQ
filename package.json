{
  "name": "kajianq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun run --filter @app/api dev",
    "build:web": "bun run --filter @app/web build",
    "build": "bun run build:web",
    "check": "tsc -p tsconfig.json && bun run --filter '@app/*' check",
    "test": "vp test run --coverage",
    "lint": "vp check && bun scripts/check-vp-vite-pin.mjs",
    "fmt": "vp fmt",
    "boundary": "bun scripts/check-boundary.mjs",
    "size-limit": "size-limit",
    "agentic-limits": "bun scripts/check-agentic-limits.mjs",
    "worktree:clean": "bun scripts/worktree-cleanup.mjs",
    "dsh:prompt": "bun scripts/dsh-dispatch-prompt.mjs",
    "openapi:check": "bun scripts/openapi-check.mjs",
    "db:up": "bun packages/infra/scripts/db-migrate.mjs up",
    "db:down": "bun packages/infra/scripts/db-migrate.mjs down",
    "db:status": "bun packages/infra/scripts/db-migrate.mjs status",
    "db:up:domain": "bun packages/infra/scripts/db-migrate.mjs up --dir packages/kajianq-domain/migrations",
    "db:down:domain": "bun packages/infra/scripts/db-migrate.mjs down --dir packages/kajianq-domain/migrations",
    "db:status:domain": "bun packages/infra/scripts/db-migrate.mjs status --dir packages/kajianq-domain/migrations",
    "db:up:api": "bun packages/infra/scripts/db-migrate.mjs up --dir apps/api/migrations",
    "db:down:api": "bun packages/infra/scripts/db-migrate.mjs down --dir apps/api/migrations",
    "db:status:api": "bun packages/infra/scripts/db-migrate.mjs status --dir apps/api/migrations",
    "db:up:all": "bun run db:up && bun run db:up:domain && bun run db:up:api",
    "db:down:all": "bun run db:down:api && bun run db:down:domain && bun run db:down",
    "db:status:all": "bun run db:status && bun run db:status:domain && bun run db:status:api",
    "db:probe:pg-search": "bun packages/infra/scripts/pg-search-probe.mjs",
    "provider:smoke": "bun packages/infra/scripts/provider-smoke.mjs",
    "eval:run": "bun packages/eval/scripts/eval-run.mjs",
    "ingest:quran": "bun packages/kajianq-domain/scripts/ingest-quran.mjs",
    "ingest:hadith": "bun packages/kajianq-domain/scripts/ingest-hadith.mjs",
    "e2e": "bddgen && playwright test",
    "deploy": "bun run build && bun run --filter '@app/api' alchemy:deploy",
    "deploy:staging": "bun run build && bun run --filter '@app/api' alchemy:deploy:staging",
    "deploy:bootstrap": "bun run build && bun run --filter '@app/api' alchemy:bootstrap",
    "deploy:bootstrap:staging": "bun run build && bun run --filter '@app/api' alchemy:bootstrap:staging",
    "deploy:bootstrap:ci": "bun run build && bun run --filter '@app/api' alchemy:bootstrap:ci",
    "deploy:bootstrap:staging:ci": "bun run build && bun run --filter '@app/api' alchemy:bootstrap:staging:ci"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fast-check/vitest": "0.4.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "playwright-bdd": "9.2.0",
    "size-limit": "13.0.3",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "size-limit": [
    {
      "name": "web-js",
      "path": "apps/web/dist/assets/*.js",
      "limit": "200 KB",
      "gzip": true
    }
  ]
}
