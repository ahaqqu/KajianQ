[{"id_ayat": 6231, "no_surah": 114, "no_ayat": 1, "teks_ayat": "قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ", "tema": "", "teks_terjemah": "Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan manusia,", "no_fn": "", "teks_fn": "", "bacaan": "qul a'uudzu birabbinnaas"}, {"id_ayat": 6232, "no_surah": 114, "no_ayat": 2, "teks_ayat": "مَلِكِ النَّاسِۙ", "tema": "", "teks_terjemah": "raja manusia,", "no_fn": "", "teks_fn": "", "bacaan": "malikinnaas"}, {"id_ayat": 6233, "no_surah": 114, "no_ayat": 3, "teks_ayat": "اِلٰهِ النَّاسِۙ", "tema": "", "teks_terjemah": "sembahan manusia", "no_fn": "", "teks_fn": "", "bacaan": "ilaahinnaas"}, {"id_ayat": 6234, "no_surah": 114, "no_ayat": 4, "teks_ayat": "مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ", "tema": "", "teks_terjemah": "dari kejahatan (setan) pembisik yang bersembunyi", "no_fn": "", "teks_fn": "", "bacaan": "min syarrilwaswaasilkhannaas"}, {"id_ayat": 6235, "no_surah": 114, "no_ayat": 5, "teks_ayat": "الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ", "tema": "", "teks_terjemah": "yang membisikkan (kejahatan) ke dalam dada manusia,", "no_fn": "", "teks_fn": "", "bacaan": "aladzii yuwaswisu fii shuduurinnaas"}, {"id_ayat": 6236, "no_surah": 114, "no_ayat": 6, "teks_ayat": "مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ ", "tema": "", "teks_terjemah": "dari (golongan) jin dan manusia.”", "no_fn": "", "teks_fn": "", "bacaan": "minaljinnati wannaas"}]