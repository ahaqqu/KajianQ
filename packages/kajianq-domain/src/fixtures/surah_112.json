[{"id_ayat": 6222, "no_surah": 112, "no_ayat": 1, "teks_ayat": "قُلْ هُوَ اللّٰهُ اَحَدٌۚ", "tema": "", "teks_terjemah": "Katakanlah (Nabi Muhammad), “Dialah Allah Yang Maha Esa.", "no_fn": "", "teks_fn": "", "bacaan": "qul huwalaahu ahad"}, {"id_ayat": 6223, "no_surah": 112, "no_ayat": 2, "teks_ayat": "اَللّٰهُ الصَّمَدُۚ", "tema": "", "teks_terjemah": "Allah tempat meminta segala sesuatu.", "no_fn": "", "teks_fn": "", "bacaan": "alaahushshamad"}, {"id_ayat": 6224, "no_surah": 112, "no_ayat": 3, "teks_ayat": "لَمْ يَلِدْ وَلَمْ يُوْلَدْۙ", "tema": "", "teks_terjemah": "Dia tidak beranak dan tidak pula diperanakkan", "no_fn": "", "teks_fn": "", "bacaan": "lam yalid walam yuulad"}, {"id_ayat": 6225, "no_surah": 112, "no_ayat": 4, "teks_ayat": "وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ࣖ", "tema": "", "teks_terjemah": "serta tidak ada sesuatu pun yang setara dengan-Nya.”", "no_fn": "", "teks_fn": "", "bacaan": "walam yakun lahu kufuwan ahad"}]