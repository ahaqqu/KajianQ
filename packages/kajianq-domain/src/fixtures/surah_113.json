[{"id_ayat": 6226, "no_surah": 113, "no_ayat": 1, "teks_ayat": "قُلْ اَعُوْذُ بِرَبِّ الْفَلَقِۙ", "tema": "", "teks_terjemah": "Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan yang (menjaga) fajar (subuh) ", "no_fn": "", "teks_fn": "", "bacaan": "qul a'uudzu birabbilfalaq"}, {"id_ayat": 6227, "no_surah": 113, "no_ayat": 2, "teks_ayat": "مِنْ شَرِّ مَا خَلَقَۙ", "tema": "", "teks_terjemah": "dari kejahatan (makhluk yang) Dia ciptakan,", "no_fn": "", "teks_fn": "", "bacaan": "min syarri maa khalaq"}, {"id_ayat": 6228, "no_surah": 113, "no_ayat": 3, "teks_ayat": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ", "tema": "", "teks_terjemah": "dari kejahatan malam apabila telah gelap gulita,", "no_fn": "", "teks_fn": "", "bacaan": "wamin syarri ghaasiqin idzaa waqab"}, {"id_ayat": 6229, "no_surah": 113, "no_ayat": 4, "teks_ayat": "وَمِنْ شَرِّ النَّفّٰثٰتِ فِى الْعُقَدِۙ", "tema": "", "teks_terjemah": "dari kejahatan perempuan-perempuan (penyihir) yang meniup pada buhul-buhul (talinya),", "no_fn": "", "teks_fn": "", "bacaan": "wamin syarrinnaffaatsaati fiil'uqad"}, {"id_ayat": 6230, "no_surah": 113, "no_ayat": 5, "teks_ayat": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ ࣖ", "tema": "", "teks_terjemah": "dan dari kejahatan orang yang dengki apabila dia dengki.”", "no_fn": "", "teks_fn": "", "bacaan": "wamin syarri haasidin idzaa hasad"}]