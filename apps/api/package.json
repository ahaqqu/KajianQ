{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CI=1 CLOUDFLARE_API_TOKEN=local-only CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 alchemy dev",
    "check": "tsc -p tsconfig.json --noEmit",
    "alchemy:deploy": "bun scripts/alchemy-preflight.mjs && alchemy deploy alchemy.run.ts --stage prod",
    "alchemy:deploy:staging": "bun scripts/alchemy-preflight.mjs && alchemy deploy alchemy.run.ts --stage staging",
    "alchemy:bootstrap": "bun scripts/alchemy-preflight.mjs && alchemy deploy alchemy.run.ts --stage prod --adopt"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/hardening": "workspace:*",
    "@app/infra": "workspace:*",
    "@app/rate": "workspace:*",
    "@hono/standard-validator": "0.4.0",
    "@sentry/cloudflare": "10.70.0",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.9",
    "@valibot/to-json-schema": "1.7.1",
    "hono": "4.13.2",
    "hono-openapi": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260816.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112",
    "typescript": "7.0.2"
  }
}
